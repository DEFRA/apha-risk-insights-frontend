# Copy to .env for local development. Defaults shown are the development defaults.
# Some defaults differ when NODE_ENV=production (noted below).

# Service version, injected into the container in CDP environments
# SERVICE_VERSION=
# IP address to bind
HOST=0.0.0.0
# Port to bind
PORT=3000
# Static cache timeout in milliseconds (default one week)
STATIC_CACHE_TIMEOUT=604800000
# Asset path
ASSET_PATH=/public

# Is logging enabled (false when NODE_ENV=test)
LOG_ENABLED=true
# Logging level
LOG_LEVEL=info
# Log output format: ecs | pino-pretty (ecs in production)
LOG_FORMAT=pino-pretty
# Log paths to redact, comma separated. Leave unset locally: an empty value breaks the logger
# LOG_REDACT=

# HTTP proxy
# HTTP_PROXY=
# Enable secure context (true in production)
ENABLE_SECURE_CONTEXT=false

# Session cache engine: memory | redis (redis in production)
SESSION_CACHE_ENGINE=memory
# Server side session cache name
SESSION_CACHE_NAME=session
# Server side session cache TTL in milliseconds (four hours)
SESSION_CACHE_TTL=14400000
# Session cookie TTL in milliseconds (four hours)
SESSION_COOKIE_TTL=14400000
# Session cookie password, must be at least 32 characters. Never reuse this value outside local development
SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
# Set the secure flag on the session cookie (true in production)
SESSION_COOKIE_SECURE=false

# Redis host
REDIS_HOST=127.0.0.1
# Redis username
REDIS_USERNAME=
# Redis password
REDIS_PASSWORD=
# Redis key prefix, isolates cached results across clients
REDIS_KEY_PREFIX=apha-risk-insights-frontend:
# Connect to a single Redis instance instead of a cluster (false in production)
USE_SINGLE_INSTANCE_CACHE=true
# Connect to Redis using TLS (true in production)
REDIS_TLS=false

# Request tracing header
TRACING_HEADER=x-cdp-request-id
