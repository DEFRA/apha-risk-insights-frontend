{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "components/change-arrow/macro.njk" import appChangeArrow %}

{% set isDetail = params.variant == "detail" %}
{% set titleHtml %}{% if isDetail %}Latest assessment{% else %}<a class="govuk-link" href="{{ params.href }}">{{ params.title }}</a>{% endif %}{% endset %}

{% set levelHtml %}
  <span class="app-risk-card__level-word">{{ params.levelLabel }}<span class="govuk-visually-hidden">, {{ params.levelNumber }} out of {{ params.levelMax }}</span></span>
  <div class="app-risk-card__bars app-risk-card__bars--{{ params.levelKey }}"
       aria-hidden="true" data-testid="app-risk-card-bars">
    {% for step in range(1, params.levelMax + 1) %}
      <span class="app-risk-card__bar{% if step <= params.levelNumber %} app-risk-card__bar--filled{% endif %}"></span>
    {% endfor %}
  </div>
{% endset %}

{% set tagHtml %}
  {{ govukTag({
    html: ('<span aria-hidden="true">' ~ (params.tag.arrow | escape) ~ '</span> ' if params.tag.arrow else '') ~ (params.tag.text | escape),
    classes: "govuk-tag--" ~ params.tag.modifier
  }) }}
{% endset %}

{% set changeTextHtml %}
  {{- appChangeArrow({ arrow: params.tag.arrow, modifier: params.tag.modifier }) -}}
  {{ params.tag.text }}
  {%- if params.previousLevel %}
  <span class="govuk-visually-hidden">,</span>
  <span class="app-risk-card__previous">Previously {{ params.previousLevel }}</span>
  {%- endif %}
{% endset %}

{% set dateHtml %}<time datetime="{{ params.dateTime }}">{{ params.dateText }}</time>{% endset %}

{% set strainRows = [{
  key: { text: "Strain" },
  value: { text: params.strain }
}] if params.strain else [] %}

{% set riskLevelRow = { key: { text: "Risk level" }, value: { html: levelHtml } } %}
{% set dateRow = { key: { text: "Date reported" if isDetail else "Reported" }, value: { html: dateHtml } } %}

{% set detailRows = [
  riskLevelRow,
  { key: { text: "Change" }, value: { html: changeTextHtml } },
  { key: { text: "Source" }, value: { text: params.source } },
  dateRow
] %}

{% set defaultRows = strainRows.concat([
  riskLevelRow,
  { key: { text: "Change" }, value: { html: tagHtml } },
  { key: { text: "Previous level" }, value: { text: params.previousText } },
  dateRow
]) %}

<div data-testid="app-risk-card"{% if isDetail %} class="app-risk-card--detail"{% endif %}>
  {{ govukSummaryList({
    card: {
      title: { html: titleHtml, headingLevel: params.headingLevel or 2 }
    },
    rows: detailRows if isDetail else defaultRows
  }) }}
</div>
