{% extends 'common/layout.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "components/risk-card/macro.njk" import appRiskCard %}
{% from "components/risk-history-chart/macro.njk" import appRiskHistoryChart %}
{% from "components/risk-history-table/macro.njk" import appRiskHistoryTable %}

{% block beforeContent %}
  {{ govukBackLink(backLink) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row app-disease-detail__row">
    <div class="govuk-grid-column-one-half">
      {{ appRiskCard(latest) }}
    </div>
    <div class="govuk-grid-column-one-half">
      {{ appRiskHistoryChart(chart) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Assessment history</h2>
      {{ appRiskHistoryTable(table) }}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {% if chart %}
    <script type="module" src="{{ getAssetPath('src/client/javascripts/risk-history-chart.js') }}"></script>
  {% endif %}
{% endblock %}
